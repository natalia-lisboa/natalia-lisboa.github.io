{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nathalia-lisboa-legaltech",
  "main": "worker.js",
  "compatibility_date": "2026-11-06",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "vars": {
    "ENVIRONMENT": "production",
    "SECURITY_POSTURE": "owasp-strict-zero-cost"
  }
}
